# Server-side only. Never place actual keys in the frontend or commit this file as .env.
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_ZONE=
OPEN_TARGETS_URL=https://api.platform.opentargets.org/api/v4/graphql
CLINICAL_TRIALS_URL=https://clinicaltrials.gov/api/v2/studies
# Optional: required only for POST /research with { "orchestrator": "strands" }.
# The Lambda role needs Bedrock InvokeModel permission and the model must be enabled in its AWS Region.
STRANDS_BEDROCK_MODEL_ID=
